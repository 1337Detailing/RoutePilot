<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/drawer_layout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layout_gravity="start"
	android:background="?attr/mapBackground">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

		<FrameLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1">

			<net.osmand.plus.views.MapViewWithLayers
				android:id="@+id/map_view_with_layers"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical" />

			<!-- OsmAnd's HUD stays inflated so its internal view lookups still work,
			     but the parent is hidden. RoutePilot owns the visible map controls. -->
			<include
				layout="@layout/map_hud_layout"
				android:visibility="gone" />

			<androidx.appcompat.widget.AppCompatImageView
				android:id="@+id/bottomShadow"
				android:layout_width="match_parent"
				android:layout_height="10dp"
				android:layout_gravity="bottom"
				android:visibility="gone"
				android:background="@drawable/bg_contextmenu_shadow_top_light" />

			<net.osmand.plus.routepilot.RoutePilotTopBarView
				android:id="@+id/routepilot_top_bar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="top"
				android:layout_marginStart="14dp"
				android:layout_marginEnd="14dp"
				android:layout_marginTop="38dp" />

			<net.osmand.plus.routepilot.RoutePilotControlsView
				android:id="@+id/routepilot_controls"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="bottom"
				android:layout_marginStart="14dp"
				android:layout_marginEnd="14dp"
				android:layout_marginBottom="22dp" />

		</FrameLayout>

	</LinearLayout>

	<!-- This was the real problem: OsmAnd's full-screen overlay sat above RoutePilot,
	     drew the old interface and consumed touches. Keep the required containers
	     in the hierarchy for code lookups, but disable the whole visible overlay
	     for the recorder-first RoutePilot UI. -->
	<FrameLayout
		android:id="@+id/routepilot_hidden_osmand_overlay"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone">

		<FrameLayout
			android:id="@+id/topFragmentContainer"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<FrameLayout
			android:id="@+id/routeMenuContainer"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<include
			layout="@layout/dashboard_over_map"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<FrameLayout
			android:id="@+id/fragmentContainer"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

	</FrameLayout>

	<!-- Drawer kept only because OsmAnd still references these IDs internally. -->
	<RelativeLayout
		android:id="@+id/drawer_relative_layout"
		android:layout_width="280dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:visibility="gone">

		<ListView
			android:id="@+id/menuItems"
			android:layout_width="280dp"
			android:layout_height="match_parent"
			android:background="?attr/bg_color"
			android:clipToPadding="false"
			android:drawSelectorOnTop="false" />

	</RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>
