{
  "version": 8,
  "name": "Routix dark",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#181825"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#243c35"
      },
      "filter": [
        "in",
        "class",
        "park",
        "grass",
        "cemetery"
      ]
    },
    {
      "id": "woods",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#243c35",
        "fill-opacity": 0.6
      },
      "filter": [
        "in",
        "class",
        "wood",
        "grass"
      ]
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#213b58"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#313244"
      },
      "minzoom": 14
    },
    {
      "id": "roads-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#242435",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.5,
          14,
          5,
          18,
          21,
          20,
          59
        ]
      },
      "filter": [
        "!=",
        "class",
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#55556c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.6,
          14,
          3,
          18,
          18,
          20,
          55
        ]
      },
      "filter": [
        "!=",
        "class",
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "paint": {
        "text-color": "#e5def6",
        "text-halo-color": "#181825",
        "text-halo-width": 1.5
      },
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "symbol-spacing": 250
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "paint": {
        "text-color": "#e5def6",
        "text-halo-color": "#181825",
        "text-halo-width": 1.5
      },
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:fr"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          12,
          14,
          17
        ]
      }
    }
  ]
}