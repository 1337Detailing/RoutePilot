<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme" version="1" map-background="{{base}}">
 <rule e="way" k="landuse|natural|leisure" v="forest|wood|grass|park|meadow"><area fill="{{park}}" /></rule>
 <rule e="way" k="natural" v="water"><area fill="{{water}}" /></rule>
 <rule e="way" k="waterway" v="*"><line stroke="{{water}}" stroke-width="2" /></rule>
 <rule e="way" k="building" v="*" zoom-min="14"><area fill="{{building}}" /></rule>
 <rule e="way" k="highway" v="*"><line stroke="{{outline}}" stroke-width="5" /><line stroke="{{road}}" stroke-width="3.5" /><rule e="way" k="name" v="*" zoom-min="14"><pathText k="name" font-size="12" fill="{{text}}" stroke="{{base}}" stroke-width="2" /></rule></rule>
 <rule e="node" k="place" v="city|town|village"><caption k="name" font-size="15" fill="{{text}}" stroke="{{base}}" stroke-width="2" /></rule>
</rendertheme>